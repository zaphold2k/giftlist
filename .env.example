# Copiar a .env y completar antes de "docker compose up".
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# Opcionales: verificación anti-bot (Cloudflare Turnstile) en el form de
# reserva. Si se dejan vacías, el widget no se muestra y el servidor no
# exige token — la app funciona igual que sin esta feature.
# Sacar las reales del dashboard de Cloudflare (Turnstile). Para desarrollo
# local, las test keys públicas de Cloudflare que siempre aprueban:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
